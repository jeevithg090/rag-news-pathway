# Copy to `.env` and fill in. Never commit real keys.

# --- Required for live news ---------------------------------------------
# Serper (https://serper.dev) - Google News / Videos search
SERPER_API_KEY=

# --- Required for AI answers --------------------------------------------
# OpenRouter (https://openrouter.ai) or any OpenAI-compatible endpoint
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000

# --- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (the Vite dev server by default)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Enables POST /api/admin/* when set (send it as the X-Admin-Token header)
ADMIN_TOKEN=

# --- Persistence ---------------------------------------------------------
# Any SQLAlchemy URL. Defaults to SQLite at ./data/news_ai.db
# DATABASE_URL=sqlite:///./data/news_ai.db

# --- Ingestion -----------------------------------------------------------
NEWS_STREAMING_ENABLED=false
# Pre-load fictional sample articles at startup (try the UI without any API keys)
DEMO_MODE=false
NEWS_FETCH_INTERVAL_SECONDS=300
# NEWS_CATEGORIES=Finance,Technology,Science,Business,Health,Entertainment,Sports,Politics,World

# --- Pathway retrieval (optional) ----------------------------------------
# URL of `python -m pipeline.document_pipeline`; global chat retrieves from it when set
# PATHWAY_RETRIEVER_URL=http://127.0.0.1:8765
PATHWAY_HOST=127.0.0.1
PATHWAY_PORT=8765
# Needed only for `--retriever knn|hybrid` (embeddings via OpenAI)
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# --- YouTube analysis (optional) -----------------------------------------
# WHISPER_MODEL=base
